ADMIN_API_TOKEN=your-secure-admin-token-here

# Required. graph_db and the neo4j container both refuse to start on a blank or
# well-known value, so there is no default to fall back to.
NEO4J_PASSWORD=your-secure-neo4j-password-here

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Required by the broker-token-guarded services and the signed-grant chain.
RECON_BROKER_TOKEN=your-secure-recon-broker-token-here
EXPLOIT_RUNNER_BROKER_TOKEN=your-secure-runner-broker-token-here
WRAITH_GATE_SECRET=your-secure-gate-secret-here

# --- Recon tool container budgets (optional; defaults shown) ---
# Per-tool wall-clock budget in seconds. Tools may override it individually
# (nuclei and katana declare their own); this is the floor for everything else.
#RECON_TOOL_TIMEOUT=300
# cgroup CPU quota: 100000 = one full CPU. Per-tool overrides (nuclei 200000,
# katana 100000) still apply where declared.
#RECON_CPU_QUOTA=50000
# Memory cap per tool container. Tools that need more (nuclei: 2g) declare it.
#RECON_MEM_LIMIT=512m

# --- LLM Provider Configuration ---

# Anthropic (default)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_API_KEY=your-key-here
LLM_TEMPERATURE=0.0

# Groq (uncomment to use)
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=your-key-here
# LLM_TEMPERATURE=0.0

# Ollama (uncomment to use, no API key needed)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:1.7b
# OLLAMA_BASE_URL=http://ollama:11434
# LLM_TEMPERATURE=0.0
