ADMIN_API_TOKEN=your-secure-admin-token-here

# Required. graph_db and the neo4j container both refuse to start on a blank or
# well-known value, so there is no default to fall back to.
NEO4J_PASSWORD=your-secure-neo4j-password-here

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Required by the broker-token-guarded services and the signed-grant chain.
RECON_BROKER_TOKEN=your-secure-recon-broker-token-here
EXPLOIT_RUNNER_BROKER_TOKEN=your-secure-runner-broker-token-here
WRAITH_GATE_SECRET=your-secure-gate-secret-here

# Required by the default ZAP service and the sandbox adapter. ZAP refuses to
# start without it, and the adapter reports an inconclusive scan rather than
# quietly running without authentication.
ZAP_API_KEY=your-secure-zap-api-key-here

# --- Redteam C2 profile (docker compose --profile redteam) ---
# The runner exposes /redteam/authorize only in redteam/both mode; the gateway
# refuses all C2 tasking unless C2_AUTONOMY is exactly "full" and the requested
# module is in the per-server allowlist.
ENGAGEMENT_MODE=wapt
C2_AUTONOMY=full
# BeEF refuses to boot with the upstream default beef:beef credentials. These
# are injected into a generated config at container start; BEEF_PASSWORD is
# required when the redteam profile is enabled.
BEEF_USERNAME=wraith
BEEF_PASSWORD=your-secure-beef-password-here
# Optional: a current BeEF REST token. Normally the gateway logs in with the
# credentials above because BeEF rotates the token on every start.
#BEEF_API_TOKEN=
# Empire seeds its first admin account from these values. The gateway logs in
# with the same credentials via the OAuth2 password flow.
EMPIRE_USERNAME=empireadmin
EMPIRE_PASSWORD=your-secure-empire-password-here
# Optional: a current Empire bearer token, if you already have one.
#EMPIRE_API_TOKEN=
# BeEF advertises this in hook.js; its port must match the published mapping.
#BEEF_PUBLIC_URL=http://127.0.0.1:3001
#BEEF_MODULE_ALLOWLIST=fingerprint_browser,get_visited_urls,get_page_html,get_geolocation,detect_social_networks
#EMPIRE_MODULE_ALLOWLIST=powershell/situational_awareness/host/win32processes,powershell/situational_awareness/host/getav,powershell/situational_awareness/network/nslookup

# --- Native host harness (docker compose --profile native-host) ---
# The bridge and agent fail closed without tokens. Host IDs must be explicitly
# authorized and must also be in the investigation's RBAC scope as
# <host_id>.native.invalid before any native_host_probe will be granted.
#NATIVE_HOST_BRIDGE_TOKEN=your-secure-native-bridge-token-here
#NATIVE_HOST_AGENT_TOKEN=your-secure-native-agent-token-here
#NATIVE_HOST_ALLOWED_HOST_IDS=authorized-host-1,authorized-host-2
#NATIVE_HOST_AGENTS=native_host_agent=http://native_host_agent:8011
#NATIVE_HOST_ALLOWED_ACTIONS=load_probe,module_check,log_write,log_verify,process_self,cleanup
#NATIVE_HOST_PROBE_LIB=/optional/benign/probe/library.so

# --- Recon tool container budgets (optional; defaults shown) ---
# Per-tool wall-clock budget in seconds. Tools may override it individually
# (nuclei and katana declare their own); this is the floor for everything else.
#RECON_TOOL_TIMEOUT=300
# cgroup CPU quota: 100000 = one full CPU. Per-tool overrides (nuclei 200000,
# katana 100000) still apply where declared.
#RECON_CPU_QUOTA=50000
# Memory cap per tool container. Tools that need more (nuclei: 2g) declare it.
#RECON_MEM_LIMIT=512m

# --- LLM Provider Configuration ---

# Anthropic (default)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_API_KEY=your-key-here
LLM_TEMPERATURE=0.0

# Groq (uncomment to use)
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=your-key-here
# LLM_TEMPERATURE=0.0

# Ollama (uncomment to use, no API key needed)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:1.7b
# OLLAMA_BASE_URL=http://ollama:11434
# LLM_TEMPERATURE=0.0
