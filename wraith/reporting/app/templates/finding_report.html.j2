<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Wraith Security Assessment Report</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #1e293b;
            background-color: #ffffff;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px;
        }

        /* Cover Page Styling */
        .cover-page {
            text-align: center;
            padding: 100px 40px;
            border-bottom: 5px solid #6366f1;
            margin-bottom: 50px;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            color: #ffffff;
            border-radius: 12px;
        }
        .cover-logo {
            font-size: 3rem;
            font-weight: 800;
            letter-spacing: -0.05em;
            color: #6366f1;
            margin-bottom: 20px;
        }
        .cover-logo span {
            color: #38bdf8;
        }
        .cover-title {
            font-size: 2.5rem;
            margin: 0;
            font-weight: 700;
        }
        .cover-subtitle {
            font-size: 1.25rem;
            color: #94a3b8;
            margin-top: 10px;
            margin-bottom: 40px;
        }
        .cover-meta {
            font-size: 0.9rem;
            color: #cbd5e1;
            font-family: monospace;
        }

        /* Generic Layout & Typography */
        h1, h2, h3, h4 {
            color: #0f172a;
            font-weight: 700;
        }
        h1 {
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 10px;
            margin-top: 40px;
        }
        h2 {
            color: #1e1b4b;
            margin-top: 30px;
            border-bottom: 1px solid #f1f5f9;
            padding-bottom: 5px;
        }
        h3 {
            color: #4f46e5;
            margin-top: 25px;
        }

        /* Badges */
        .badge {
            display: inline-block;
            padding: 4px 12px;
            font-size: 0.8rem;
            font-weight: bold;
            border-radius: 9999px;
            text-transform: uppercase;
        }
        .badge-critical { background-color: #fecaca; color: #991b1b; }
        .badge-high { background-color: #fed7aa; color: #9a3412; }
        .badge-medium { background-color: #fef08a; color: #854d0e; }
        .badge-low { background-color: #dcfce7; color: #166534; }
        .badge-info { background-color: #e0f2fe; color: #075985; }

        /* Tables */
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            font-size: 0.95rem;
        }
        th, td {
            border: 1px solid #e2e8f0;
            padding: 12px 15px;
            text-align: left;
        }
        th {
            background-color: #f8fafc;
            color: #334155;
            font-weight: 600;
        }
        tr:nth-child(even) {
            background-color: #fafafa;
        }

        /* Callout Box / Executive Summary Band */
        .alert-band {
            background: #eef2ff;
            border-left: 5px solid #4f46e5;
            padding: 20px;
            border-radius: 0 8px 8px 0;
            margin: 25px 0;
        }
        .alert-title {
            font-weight: bold;
            font-size: 1.1rem;
            color: #1e1b4b;
            margin-bottom: 8px;
        }

        /* Findings Layout */
        .finding-box {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 25px;
            margin-bottom: 40px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            page-break-after: always;
        }

        /* Timeline */
        .timeline {
            position: relative;
            margin: 25px 0;
            padding-left: 20px;
            border-left: 2px solid #e2e8f0;
        }
        .timeline-event {
            position: relative;
            margin-bottom: 20px;
        }
        .timeline-event::before {
            content: '';
            position: absolute;
            left: -27px;
            top: 5px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #6366f1;
            border: 2px solid #ffffff;
        }
        .timeline-time {
            font-family: monospace;
            font-size: 0.85rem;
            color: #64748b;
            font-weight: bold;
        }
        .timeline-desc {
            font-size: 0.95rem;
            color: #334155;
            margin-top: 2px;
        }

        /* Attack Graph Visualization */
        .attack-graph-container {
            background: #0f172a;
            color: #38bdf8;
            padding: 20px;
            border-radius: 8px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.9rem;
            line-height: 1.4;
            margin: 20px 0;
            border: 1px solid #1e293b;
            white-space: pre-wrap;
            overflow-x: auto;
        }
        .graph-node {
            color: #f1f5f9;
            font-weight: bold;
        }
        .graph-arrow {
            color: #6366f1;
            font-weight: bold;
        }

        /* Evidence Box */
        .evidence-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 15px;
            font-family: 'Courier New', Courier, monospace;
            white-space: pre-wrap;
            font-size: 0.85rem;
            color: #0f172a;
            border-radius: 6px;
            margin: 15px 0;
            max-height: 300px;
            overflow-y: auto;
        }

        /* Support Footer */
        .support-box {
            background: #faf5ff;
            border: 1px solid #f3e8ff;
            border-radius: 8px;
            padding: 20px;
            margin-top: 40px;
        }
        .support-title {
            font-weight: bold;
            color: #581c87;
            margin-bottom: 5px;
        }
    </style>
</head>
<body>
    <div class="container">

        <!-- Cover Page -->
        <div class="cover-page">
            <div class="cover-logo">WRAITH<span>.IO</span></div>
            <h1 class="cover-title">Autonomous Security Assessment Report</h1>
            <div class="cover-subtitle">Target Investigation: {{ program_name }}</div>
            <div class="cover-meta">
                Generated At: {{ generated_at.strftime('%Y-%m-%d %H:%M:%S UTC') }}<br>
                Investigation ID: {{ investigation_id or 'N/A' }}
            </div>
        </div>

        <!-- Executive Summary -->
        <h1>1. Executive Summary</h1>
        {% if executive_summary %}
        <div class="alert-band">
            <div class="alert-title">OVERALL SECURITY POSTURE: <span style="text-decoration: underline;">{{ executive_summary.overall_posture }}</span></div>
            <p style="margin: 0; font-size: 0.95rem; color: #3730a3;">
                {{ executive_summary.assessment_comment }}
            </p>
        </div>

        <div style="display: flex; gap: 20px; margin-bottom: 30px;">
            <div style="flex: 1; background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
                <span style="font-size: 0.85rem; text-transform: uppercase; color: #64748b; font-weight: bold;">Average Risk Rating</span>
                <div style="font-size: 2rem; font-weight: bold; color: #4f46e5; margin-top: 5px;">{{ executive_summary.average_risk_score }} / 10</div>
            </div>
            <div style="flex: 1; background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
                <span style="font-size: 0.85rem; text-transform: uppercase; color: #64748b; font-weight: bold;">Confirmed Vulnerabilities</span>
                <div style="font-size: 2rem; font-weight: bold; color: #0f172a; margin-top: 5px;">{{ executive_summary.confirmed_count if executive_summary.confirmed_count is not none else (findings|length) }}</div>
            </div>
            {% if executive_summary.unvalidated_count %}
            <div style="flex: 1; background: #fffbeb; padding: 15px; border-radius: 8px; border: 1px solid #fcd34d; text-align: center;">
                <span style="font-size: 0.85rem; text-transform: uppercase; color: #92400e; font-weight: bold;">Unvalidated Hypotheses</span>
                <div style="font-size: 2rem; font-weight: bold; color: #92400e; margin-top: 5px;">{{ executive_summary.unvalidated_count }}</div>
            </div>
            {% endif %}
        </div>

        {% if executive_summary.unvalidated_count %}
        <div class="alert-band" style="background: #fffbeb; border-color: #fcd34d;">
            <div class="alert-title" style="color: #92400e;">UNVALIDATED HYPOTHESES ARE NOT FINDINGS</div>
            <p style="margin: 0; font-size: 0.95rem; color: #92400e;">
                {{ executive_summary.unvalidated_count }} item(s) in this report were produced by
                automated reconnaissance and were never confirmed against the target. They are
                included as leads for follow-up. Do not submit them as vulnerabilities.
            </p>
        </div>
        {% endif %}

        <h3>Severity Breakdown</h3>
        <table>
            <thead>
                <tr>
                    <th>Critical</th>
                    <th>High</th>
                    <th>Medium</th>
                    <th>Low</th>
                    <th>Info</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="badge badge-critical">{{ executive_summary.severity_breakdown.Critical or 0 }}</span></td>
                    <td><span class="badge badge-high">{{ executive_summary.severity_breakdown.High or 0 }}</span></td>
                    <td><span class="badge badge-medium">{{ executive_summary.severity_breakdown.Medium or 0 }}</span></td>
                    <td><span class="badge badge-low">{{ executive_summary.severity_breakdown.Low or 0 }}</span></td>
                    <td><span class="badge badge-info">{{ executive_summary.severity_breakdown.Info or 0 }}</span></td>
                </tr>
            </tbody>
        </table>
        {% endif %}

        {% if summary_line %}
        <p style="font-size: 0.9rem; color: #64748b; font-style: italic; margin-top: 15px;">
            {{ summary_line }}
        </p>
        {% endif %}

        <!-- Unified Timeline -->
        {% if timeline %}
        <h2>2. Validation Timeline</h2>
        <p>This chronological timeline shows when targets were audited, when vulnerabilities were identified, and when autonomous exploitation verifications were completed.</p>
        <div class="timeline">
            {% for event in timeline %}
            <div class="timeline-event">
                <div class="timeline-time">{{ event.timestamp }}</div>
                <div class="timeline-desc">{{ event.event }}</div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Overall Attack Paths -->
        {% if attack_graph %}
        <h2>3. Attack Graph & Entry Points</h2>
        <p>The following structural representation outlines the identified attack surface and entry paths connecting target hosts to sensitive parameters and vulnerabilities.</p>
        <div class="attack-graph-container">
            <span class="graph-node">Investigation: {{ program_name }}</span><br>
            {% for path in attack_graph.paths_summary %}
            <span class="graph-arrow"> └── </span>{{ path }}<br>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Technical Findings -->
        <h1>4. Detailed Technical Findings</h1>

        {% if not findings %}
        <p>No active vulnerabilities were identified in the scope of this investigation.</p>
        {% endif %}

        {% for f in findings %}
        <div class="finding-box">
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                <div>
                    {% if f.validation_state != 'CONFIRMED' %}
                    <div style="display: inline-block; background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; border-radius: 4px; padding: 3px 8px; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">
                        Unvalidated hypothesis — not a confirmed vulnerability
                    </div>
                    {% endif %}
                    <h2 style="margin: 0; color: #0f172a; font-size: 1.5rem;">
                        {% if f.validation_state == 'CONFIRMED' %}Finding:{% else %}Unvalidated Hypothesis:{% endif %} {{ f.title }}
                    </h2>
                </div>
                <div>
                    <span class="badge badge-{{ f.severity|lower }}">{{ f.severity }}</span>
                </div>
            </div>

            <!-- Risk Rating / CVSS Box -->
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 15px; margin-bottom: 20px; display: flex; gap: 15px;">
                <div style="flex: 1;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: bold;">Risk Level</div>
                    <div style="font-size: 1.1rem; font-weight: bold; color: #0f172a; margin-top: 3px;">{{ f.severity }}</div>
                </div>
                <div style="flex: 1;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: bold;">CVSS Rating</div>
                    <div style="font-size: 1.1rem; font-weight: bold; color: #0f172a; margin-top: 3px;">{{ f.cvss_score }}</div>
                </div>
                <div style="flex: 1;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: bold;">AI Verification Confidence</div>
                    <div style="font-size: 1.1rem; font-weight: bold; color: #0f172a; margin-top: 3px;">{{ f.ai_confidence }}</div>
                </div>
            </div>

            <h3>A. Summary</h3>
            <p>{{ f.description }}</p>

            <h3>B. Weakness</h3>
            <p>{{ f.vulnerability_type }}</p>

            <h3>C. Severity &amp; CVSS Rationale</h3>
            <p><strong>Vector:</strong> <code>{{ f.cvss_vector or 'N/A' }}</code></p>
            {% if f.risk_rating and f.risk_rating.cvss_rationale %}
            <table>
                <thead>
                    <tr>
                        <th>Metric</th>
                        <th>Value</th>
                        <th>Reasoning</th>
                    </tr>
                </thead>
                <tbody>
                    {% for m in f.risk_rating.cvss_rationale %}
                    <tr>
                        <td style="font-weight: 600;">{{ m.metric }}</td>
                        <td><span class="badge">{{ m.value }}</span></td>
                        <td>{{ m.meaning }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p style="color: #64748b; font-size: 0.95rem;">No CVSS vector recorded, so no metric-by-metric rationale is available.</p>
            {% endif %}

            <h3>D. Affected Asset</h3>
            <div style="font-family: monospace; background: #f1f5f9; padding: 10px; border-radius: 4px; font-size: 0.9rem;">
                {{ f.affected_asset }}
            </div>

            <h3>E. Steps to Reproduce</h3>
            {% if f.poc_request %}
            <ol>
                <li>Target the asset below.</li>
                <li>Send the request exactly as shown (method, path, headers, body).</li>
                <li>Compare the response against the Expected / Actual behaviour.</li>
            </ol>
            <h4>Request</h4>
            <div class="evidence-box">{{ f.poc_request }}</div>
            {% else %}
            <div class="evidence-box">{{ f.steps_to_reproduce }}</div>
            {% endif %}

            <h3>F. Expected vs. Actual</h3>
            {% if f.expected_result %}
            <p><strong>Expected:</strong> {{ f.expected_result }}</p>
            <p><strong>Actual:</strong> {{ f.actual_result }}</p>
            {% else %}
            <p style="color: #64748b; font-size: 0.95rem;">Not yet validated by an executed request — this finding remains a scanner hypothesis.</p>
            {% endif %}

            {% if f.poc_response %}
            <h3>G. Proof of Concept — Observed Response</h3>
            {% if f.validation_stage %}
            <p><em>Validation stage reached: {{ f.validation_stage }}</em></p>
            {% endif %}
            <div class="evidence-box">{{ f.poc_response }}</div>
            {% endif %}

            <h3>H. Impact</h3>
            <p>{{ f.business_impact }}</p>

            <h3>I. Remediation</h3>
            <p><strong>Recommended action:</strong> {{ f.suggested_remediation }}</p>

            <h3>J. Evidence &amp; Raw Output</h3>
            <div class="evidence-box">{{ f.evidence }}</div>

            <div style="margin-top: 25px; font-size: 0.8rem; color: #64748b; border-top: 1px solid #f1f5f9; padding-top: 10px;">
                <strong>Discovery Metadata:</strong> Discovered by {{ f.discovery_metadata.tool }} | Program: {{ f.discovery_metadata.program }} | Timestamp: {{ f.discovery_metadata.timestamp }}
            </div>
        </div>
        {% endfor %}

        <!-- Help & Support Section -->
        <div class="support-box">
            <div class="support-title">5. Support & Assistance Contact</div>
            <p style="margin: 0; font-size: 0.95rem; color: #5b21b6;">
                Need help fixing these vulnerabilities? Our product security specialists are available to walk through remediation steps, perform code reviews of security patches, or execute validation rescans.
            </p>
            <ul style="margin: 10px 0 0 0; padding-left: 20px; font-size: 0.9rem; color: #581c87;">
                {% if support_resources %}
                    {% for res in support_resources %}
                    <li><strong>{{ res.channel }}:</strong> <a href="#" style="color: #4f46e5; text-decoration: none;">{{ res.contact }}</a></li>
                    {% endfor %}
                {% else %}
                    <li><strong>Product Security:</strong> <a href="mailto:security@wraith.io" style="color: #4f46e5; text-decoration: none;">security@wraith.io</a></li>
                    <li><strong>On-Call Incident Response:</strong> +1 (800) WRAITH-SEC</li>
                {% endif %}
            </ul>
        </div>

    </div>
</body>
</html>
